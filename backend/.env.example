PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
DB_HOST=localhost
DB_PORT=3306
DB_USER=ipo_user
DB_PASSWORD=ipo_password
DB_NAME=ipo_team

# Shared remote MySQL (Hostinger, etc.): use 2–3 max. Vercel defaults to 2 automatically.
# DB_CONNECTION_LIMIT=2

# Public site URL (used in verification / reset links)
FRONTEND_URL=http://localhost:5173

# SMTP (Gmail: use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# Sender display — pick ONE approach:
# 1) Recommended on Vercel (no quotes, no angle brackets):
SMTP_FROM_NAME=IPO Team Manager
# 2) Or full RFC format in .env only (local):
# SMTP_FROM=IPO Team Manager <you@gmail.com>
#
# On Vercel dashboard: do NOT wrap values in quotes.
# The From address must match SMTP_USER (or a Gmail alias you configured).

APP_NAME=IPO Team Manager
