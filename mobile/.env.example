# Backend API base URL (no trailing slash)
# Production (Vercel):
EXPO_PUBLIC_API_BASE_URL=https://ipo-manager-one.vercel.app/api

# Physical phone on same Wi‑Fi (replace with your PC's IPv4 from ipconfig):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.83:5000/api

# Android emulator → host machine:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api
